{
	"$schema": "http://json.schemastore.org/package",
	"name": "miruka-resource",
	"version": "0.1.0",
	"description": "",
	"contributors": [
		"Alikuxac <alikuxac.dev@gmail.com>"
	],
	"license": "MIT",
	"private": true,
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc",
		"deploy": "node --unhandled-rejections=strict dist/index.js",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"prettier": "prettier --write **/*.{ts,js,json,yml,yaml}"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dMirukali/resources.git"
	},
	"bugs": {
		"url": "https://github.com/Mirukali/resources/issues"
	},
	"homepage": "https://github.com/Mirukali/resources#readme",
	"keywords": [
		"miruka",
		"discord"
	],
	"dependencies": {
		"discord.js": "^14.27.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-angular": "^21.2.2",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.1",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"discord-api-types": "^0.38.55",
		"eslint": "^10.10.0",
		"eslint-config-marine": "^9.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=16.9.0"
	},
	"eslintConfig": {
		"extends": "marine/prettier/node",
		"parserOptions": {
			"project": "./tsconfig.eslint.json"
		},
		"rules": {
			"@typescript-eslint/naming-convention": 0
		}
	},
	"prettier": {
		"printWidth": 120,
		"useTabs": true,
		"singleQuote": true,
		"quoteProps": "as-needed",
		"trailingComma": "all",
		"endOfLine": "lf"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged",
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
		}
	},
	"lint-staged": {
		"*.js": [
			"prettier --write"
		],
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,yml,yaml}": [
			"prettier --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-angular"
		],
		"rules": {
			"type-enum": [
				2,
				"always",
				[
					"chore",
					"build",
					"ci",
					"docs",
					"feat",
					"fix",
					"perf",
					"refactor",
					"revert",
					"style",
					"test",
					"types",
					"wip"
				]
			]
		}
	},
	"packageManager": "yarn@4.18.0"
}
