{
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ES2019",
		"lib": [
			"ESNext"
		],
		"declaration": true,
		"sourceMap": true,
		"removeComments": false,
		"alwaysStrict": true,
		"pretty": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"incremental": true,
		"noEmitHelpers": true,
		"importHelpers": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": [
			"node"
		]
	},
	"files": [
		"src/index.ts"
	]
}